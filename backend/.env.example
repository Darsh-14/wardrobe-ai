# Copy to .env and fill in. Never commit .env or ship the service role key to the browser.
PORT=8787
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:8787
# Folder with the built web app (frontend/dist) to serve from this API; the Docker image sets it
STATIC_DIR=

# Supabase > Project Settings > Database > Connection string (Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy JWT secret (HS256). Leave empty if the project uses JWT signing keys (verified via JWKS).
SUPABASE_JWT_SECRET=

# "supabase", or "local" for dev without Supabase Storage
STORAGE_DRIVER=supabase

# "gemini" (free tier), "mock" for dev without a key, or "claude" (paid)
AI_PROVIDER=gemini
# Free key, no billing needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-* models are closed to new keys. For higher free limits try gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy or rate limited
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# Only for AI_PROVIDER=claude (paid)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# PAID, leave empty to stay free. Image generation + background removal (Replicate).
# Without a token the API shows the item photos instead of generated visualizations.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_BG_REMOVAL_MODEL=851-labs/background-remover

# "open-meteo" (free, no key) or "mock"
WEATHER_PROVIDER=open-meteo

# Free pictures (studio photos of items, "see it on you", recommendations, trends): Cloudflare Workers AI,
# free plan, no card. Dashboard > AI > Workers AI > Use REST API gives both values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# pollinations now asks for payment after one image, so keep this at none
FREE_IMAGES=none
# Optional: a Gemini image model that dresses the model in your actual pieces and face photo
# (e.g. gemini-2.5-flash-image). Leave empty unless your key has a free quota for it.
GEMINI_IMAGE_MODEL=
